NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/food2

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# CORS — comma-separated list of allowed origins, or "*" to allow any origin
CLIENT_URLS=http://localhost:3000,https://your-user-app.com,https://your-admin-app.com

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin account (run: npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
