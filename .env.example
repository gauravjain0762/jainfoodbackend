NODE_ENV=development
PORT=5000

# MongoDB
MONGO_URI=mongodb://127.0.0.1:27017/food2

# Auth
JWT_SECRET=change_this_secret
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change_this_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d

# Cloudinary (image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Seed admin account (run: npm run seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# Email (order notifications via nodemailer/Gmail)
# EMAIL_USER: a Gmail address. EMAIL_PASS: a Gmail App Password — generate
# one at https://myaccount.google.com/apppasswords (needs 2-Step Verification).
EMAIL_USER=
EMAIL_PASS=
ADMIN_NOTIFY_EMAIL=
